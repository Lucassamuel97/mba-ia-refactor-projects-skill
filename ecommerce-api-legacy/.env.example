# Todas as variáveis são opcionais: a aplicação sobe sem nenhuma delas.
# Exporte-as no ambiente antes do `npm start` (o projeto não carrega .env sozinho).

# Porta HTTP (padrão: 3000)
PORT=3000

# Token das rotas administrativas, enviado no cabeçalho X-Admin-Token.
# Sem ele, GET /api/admin/financial-report e DELETE /api/users/:id respondem 403.
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio

# Chave do gateway de pagamento. Sem ela, o gateway segue apenas em modo simulado.
PAYMENT_GATEWAY_KEY=pk_test_exemplo

# Nível de log: error, warn, info (padrão) ou debug
LOG_LEVEL=info
