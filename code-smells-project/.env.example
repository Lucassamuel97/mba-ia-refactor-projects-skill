# Todas as variáveis são opcionais: sem nenhuma delas, `python app.py` sobe em
# http://127.0.0.1:5000. A aplicação lê o ambiente do processo; ela não carrega
# este arquivo sozinha (exporte as variáveis ou use uma ferramenta de sua escolha).

# Chave do Flask. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# Token das rotas /admin/*, enviado no cabeçalho X-Admin-Token.
# Sem ele, as rotas administrativas respondem 403.
ADMIN_TOKEN=troque-por-um-token-secreto

APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false
APP_ENV=producao
DATABASE_PATH=loja.db
LOG_LEVEL=INFO
