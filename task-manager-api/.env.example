# Copie para .env e ajuste. Nenhuma variável é obrigatória para rodar em desenvolvimento.
# Sem SECRET_KEY, uma chave efêmera é gerada a cada boot (os tokens de login expiram ao reiniciar).
SECRET_KEY=troque-por-uma-chave-aleatoria
DATABASE_URL=sqlite:///tasks.db
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=5000
# Origens liberadas para CORS, separadas por vírgula. Vazio = nenhuma origem externa.
CORS_ORIGINS=http://localhost:3000
