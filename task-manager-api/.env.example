# Todas as variáveis são opcionais: sem nenhuma delas, `python app.py` sobe em
# http://127.0.0.1:5000. Copie este arquivo para `.env` para alterar os padrões;
# a aplicação carrega o `.env` da raiz do projeto ao iniciar.

# Chave do Flask. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=troque-por-um-valor-aleatorio-longo

APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///tasks.db

# Origens aceitas pelo CORS, separadas por vírgula. `*` aceita qualquer origem.
CORS_ORIGINS=*

# Envio de email do NotificationService. Sem SMTP_USER e SMTP_PASSWORD, fica desligado.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
